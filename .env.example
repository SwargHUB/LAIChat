# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Optional API key for Cloud OpenAI-compatible providers (DeepSeek, OpenRouter, Groq, Together AI, OpenAI)
OPENAI_API_KEY=""

# OPENAI_BASE_URL: Base URL for OpenAI-compatible API (e.g. https://api.deepseek.com/v1, https://openrouter.ai/api/v1, https://api.groq.com/openai/v1)
OPENAI_BASE_URL="https://api.openai.com/v1"
