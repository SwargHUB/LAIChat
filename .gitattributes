# Нормализуем переносы строк: в репозитории всегда LF
* text=auto eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.md   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.iss  text eol=lf
*.ps1  text eol=crlf

# Пакетные файлы Windows требуют CRLF: с LF не работает переход goto,
# и лаунчер молча ничего не запускает.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Бинарные
*.gguf binary
*.exe  binary
*.dll  binary
*.so   binary
*.png  binary
*.jpg  binary
*.ico  binary
